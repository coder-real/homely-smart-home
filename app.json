{
  "expo": {
    "name": "Homely",
    "slug": "homely-smart-home",
    "owner": "coder-real",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080C14",
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#080C14"
      },
      "package": "com.homely.smarthome",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-status-bar",
      "expo-asset",
      "expo-sharing",
      [
        "@isvend/expo-udp",
        {
          "localNetworkUsageDescription": "This app uses the local network to discover and communicate with your Homely Smart Home device."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "44b81edc-571b-4bf3-b4fb-b673775fbabb"
      }
    }
  }
}
